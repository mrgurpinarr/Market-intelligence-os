# Database Connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/market_intelligence

# DeepSeek LLM API Key (Multi-Agent Research Engine)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# CoinMarketCap Pro API Key (Live Screener & Metrics)
CMC_API_KEY=your_cmc_api_key_here

# Telegram Bot Token (Grammy Bot & Live Anomaly Alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_REPORT_CHAT_ID=your_telegram_chat_id_here

# NextAuth Configuration (Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
